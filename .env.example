# ====================================================================
# APX DIGITAL — PRODUCTION CONFIGURATION TEMPLATE (.env.example)
# ====================================================================

# Port for Backend Server
PORT=5000

# Secret Key for Admin Authentication JWT Tokens (Use high-entropy string)
JWT_SECRET=your_super_secret_high_entropy_jwt_key_here

# PostgreSQL Database Connection String
# Example: postgresql://<user>:<password>@localhost:5432/<dbname>
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/apx_digital

# Root Administrator Defaults (Used for initialization)
INITIAL_ADMIN_USERNAME=APK
INITIAL_ADMIN_PASSWORD=2589
ADMIN_EMAIL=admin@apxdigital.com

# Client Origin (CORS)
CLIENT_URL=http://localhost:5173
